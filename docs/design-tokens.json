{
  "$schemaComment": "Portable design tokens for my-raid-cds — Super ★ chrome + domain overlays.",
  "meta": {
    "name": "my-raid-cds",
    "version": "2.0.0",
    "themeId": "super",
    "sources": [
      "docs/theme-super.json",
      "src/theme/create-app-theme.ts",
      "src/theme/links.css",
      "src/theme/tooltip-surface.ts",
      "src/index.css",
      "src/App.css"
    ],
    "muiSpacingPx": 8,
    "bilingualFonts": {
      "rule": "RU+EN — Cyrillic + Latin required",
      "body": "Noto Sans",
      "display": "Onest",
      "mono": ["JetBrains Mono", "IBM Plex Mono"]
    }
  },
  "semantics": {
    "brandNotPrimary": true,
    "primaryIsInverseInk": true,
    "okIsGreen": true,
    "dangerIsRed": true,
    "brandDistinctFromDangerAndOk": true,
    "interactiveBorder": "#8a8a8a",
    "domain": {
      "bisReady": "ok",
      "defect": "danger",
      "missingBisHints": "warning",
      "ilvlUpgradeHints": "info"
    }
  },
  "typography": {
    "fontFamily": {
      "body": "'Noto Sans', system-ui, sans-serif",
      "display": "'Onest', 'Noto Sans', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'IBM Plex Mono', monospace"
    },
    "brandNameWeight": 700,
    "proseLineHeight": 1.55,
    "button": {
      "textTransform": "none",
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "h6": { "fontFamily": "display", "fontWeight": 700, "letterSpacing": "-0.02em" },
    "subtitle1": { "fontFamily": "display", "fontWeight": 600, "letterSpacing": "-0.01em" }
  },
  "shape": {
    "borderRadius": 10,
    "controlBorderRadius": 8,
    "dialogBorderRadius": 12,
    "filterCardBorderRadius": 8,
    "inlineMentionBorderRadius": 8,
    "iconThumbBorderRadius": 4,
    "scrollbarThumbBorderRadius": 999,
    "gap": "0.55rem",
    "pad": "0.65rem"
  },
  "borders": {
    "width": "1px",
    "style": "solid",
    "defaultColorToken": "divider",
    "interactive": "#8a8a8a"
  },
  "spacingRecipes": {
    "panelPadding": { "xs": 12, "sm": 16 },
    "filterSectionPadding": 10,
    "stackPanel": 12,
    "formFieldGap": 10
  },
  "shadows": {
    "card": {
      "light": "0 6px 18px rgba(0, 0, 0, 0.07)",
      "dark": "0 8px 24px rgba(0, 0, 0, 0.4)"
    },
    "inlineMention": {
      "light": "0 1px 1px rgba(0, 0, 0, 0.04)",
      "dark": "0 1px 1px rgba(0, 0, 0, 0.25)"
    },
    "menu": {
      "light": "0 8px 24px rgba(0, 0, 0, 0.12)",
      "dark": "0 8px 24px rgba(0, 0, 0, 0.45)"
    },
    "stickyColumnEdge": "1px 0 0 rgba(0,0,0,0.08)"
  },
  "scrollbar": {
    "sizePx": 8,
    "track": "transparent",
    "thumb": { "light": "#c4c4c0", "dark": "#555555" },
    "thumbHover": { "light": "#8a8a8a", "dark": "#8a8a8a" }
  },
  "shell": {
    "toolbarMinHeightPx": { "xs": 56, "sm": 64 },
    "mainPadding": {
      "top": { "xs": "1.5rem", "sm": "2rem" },
      "x": { "xs": "1.25rem", "sm": "1.75rem" },
      "bottom": "2rem"
    }
  },
  "colorMode": {
    "htmlAttribute": "data-color-mode",
    "storageKeyExample": "my-raid-cds-color-mode",
    "themeColorMeta": {
      "light": "#fcfbf9",
      "dark": "#1a1a1a"
    }
  },
  "cssVariables": {
    "light": {
      "--bg": "#fcfbf9",
      "--page-bg": "#fcfbf9",
      "--surface": "#ffffff",
      "--chip-bg": "#f3f2ef",
      "--header-bg": "rgba(252, 251, 249, 0.96)",
      "--border": "#8a8a8a",
      "--text": "#141414",
      "--text-strong": "#0a0a0a",
      "--text-muted": "#555555",
      "--brand": "#9a3412",
      "--brand-soft": "#fff7ed",
      "--brand-border": "#c2410c",
      "--ok": "#166534",
      "--ok-bg": "#ecfdf5",
      "--ok-border": "#166534",
      "--danger": "#dc2626",
      "--danger-bg": "#fef2f2",
      "--danger-border": "#dc2626",
      "--link": "#2c5282",
      "--link-spot": "#9a3412",
      "--primary-bg": "#0a0a0a",
      "--primary-fg": "#ffffff",
      "--shadow": "0 6px 18px rgba(0, 0, 0, 0.07)",
      "--scrollbar-size": "8px",
      "--scrollbar-track": "transparent",
      "--scrollbar-thumb": "#c4c4c0",
      "--scrollbar-thumb-hover": "#8a8a8a"
    },
    "dark": {
      "--bg": "#1a1a1a",
      "--page-bg": "#1a1a1a",
      "--surface": "#242424",
      "--chip-bg": "#1f1f1f",
      "--header-bg": "rgba(26, 26, 26, 0.96)",
      "--border": "#8a8a8a",
      "--text": "#f2f2f2",
      "--text-strong": "#fafafa",
      "--text-muted": "#a3a3a3",
      "--brand": "#fb923c",
      "--brand-soft": "#3d2818",
      "--brand-border": "#fb923c",
      "--ok": "#86efac",
      "--ok-bg": "rgba(134, 239, 172, 0.12)",
      "--ok-border": "#86efac",
      "--danger": "#ff7b72",
      "--danger-bg": "rgba(255, 123, 114, 0.14)",
      "--danger-border": "#ff7b72",
      "--link": "#8ab4c8",
      "--link-spot": "#fb923c",
      "--primary-bg": "#fafafa",
      "--primary-fg": "#111111",
      "--shadow": "0 8px 24px rgba(0, 0, 0, 0.4)",
      "--scrollbar-thumb": "#555555",
      "--scrollbar-thumb-hover": "#8a8a8a"
    }
  },
  "palette": {
    "light": {
      "primary": { "main": "#0a0a0a", "light": "#333333", "dark": "#000000", "contrastText": "#ffffff" },
      "secondary": { "main": "#9a3412", "light": "#c2410c", "dark": "#7c2d12", "contrastText": "#ffffff" },
      "success": { "main": "#166534", "contrastText": "#ffffff" },
      "error": { "main": "#dc2626", "contrastText": "#ffffff" },
      "info": { "main": "#0284c7", "light": "#38bdf8", "dark": "#0369a1" },
      "warning": { "main": "#d97706", "light": "#fbbf24", "dark": "#b45309" },
      "background": { "default": "#fcfbf9", "paper": "#ffffff" },
      "divider": "#8a8a8a",
      "text": { "primary": "#141414", "secondary": "#555555" },
      "action": {
        "hover": "rgba(20, 20, 20, 0.04)",
        "selected": "rgba(154, 52, 18, 0.1)"
      },
      "inputHoverBorder": "#6b6b6b"
    },
    "dark": {
      "primary": { "main": "#fafafa", "light": "#ffffff", "dark": "#e5e5e5", "contrastText": "#111111" },
      "secondary": { "main": "#fb923c", "light": "#fdba74", "dark": "#ea580c", "contrastText": "#111111" },
      "success": { "main": "#86efac", "contrastText": "#111111" },
      "error": { "main": "#ff7b72", "contrastText": "#111111" },
      "info": { "main": "#38bdf8", "light": "#7dd3fc", "dark": "#0284c7" },
      "warning": { "main": "#f59e0b", "light": "#fbbf24", "dark": "#d97706" },
      "background": { "default": "#1a1a1a", "paper": "#242424" },
      "divider": "#8a8a8a",
      "text": { "primary": "#f2f2f2", "secondary": "#a3a3a3" },
      "action": {
        "hover": "rgba(242, 242, 242, 0.06)",
        "selected": "rgba(251, 146, 60, 0.18)"
      },
      "inputHoverBorder": "#a3a3a3"
    }
  },
  "linkStyles": {
    "quiet": {
      "colorToken": "link",
      "fontWeight": 500,
      "textDecorationThickness": "1px",
      "textUnderlineOffset": "3px"
    },
    "spot": {
      "className": "link-spot",
      "colorToken": "linkSpot",
      "fontFamilyToken": "display",
      "fontWeight": 700,
      "fontStyle": "italic",
      "textDecorationThickness": "2px",
      "textUnderlineOffset": "3px",
      "letterSpacing": "0.01em"
    }
  },
  "atmosphere": {
    "light": "radial-gradient(1200px 600px at 10% -10%, rgba(154, 52, 18, 0.06), transparent 55%), radial-gradient(900px 500px at 100% 0%, rgba(194, 65, 12, 0.04), transparent 50%)",
    "dark": "radial-gradient(1000px 520px at 8% -12%, rgba(251, 146, 60, 0.1), transparent 55%), radial-gradient(800px 480px at 100% 0%, rgba(61, 40, 24, 0.45), transparent 50%)",
    "backgroundAttachment": "fixed"
  },
  "components": {
    "outlinedPaper": {
      "borderColor": "divider",
      "shadowToken": "card"
    },
    "filterSection": {
      "border": 1,
      "borderColor": "divider",
      "borderRadiusThemeUnits": 1,
      "paddingThemeUnits": 1.25,
      "titleVariant": "body2",
      "titleFontWeight": 600,
      "descriptionVariant": "caption"
    },
    "button": {
      "disableElevation": true,
      "borderRadius": 8,
      "primaryIsInverseInk": true,
      "outlinedFillAlpha": { "light": 0.7, "dark": 0.4 }
    },
    "outlinedInput": {
      "fillAlpha": { "light": 0.8, "dark": 0.35 }
    },
    "dialog": {
      "borderRadius": 12,
      "border": "1px solid divider"
    },
    "tableContainer": {
      "borderRadiusToken": "shape.borderRadius",
      "border": "1px solid divider",
      "shadowToken": "card"
    }
  },
  "domain": {
    "comment": "Product-specific; omit when seeding a unrelated UI.",
    "tooltipSurface": {
      "light": {
        "bgcolor": "#27272a",
        "color": "#fafafa",
        "mutedColor": "#d4d4d8",
        "borderColor": "#3f3f46"
      },
      "dark": {
        "bgcolor": "#3f3f46",
        "color": "#fafafa",
        "mutedColor": "#d4d4d8",
        "borderColor": "#52525b"
      }
    },
    "gearHintAlphas": {
      "bis": {
        "light": [0, 0.22, 0.32, 0.44],
        "dark": [0, 0.26, 0.38, 0.5]
      },
      "ilvl": {
        "light": [0, 0.18, 0.28, 0.4],
        "dark": [0, 0.22, 0.34, 0.46]
      }
    },
    "itemLevelTier": {
      "thresholds": [277, 264, 258, 251, 245, 232, 226, 219, 213, 200],
      "colorsLight": [
        "#64748b",
        "#15803d",
        "#16a34a",
        "#0891b2",
        "#0284c7",
        "#2563eb",
        "#4338ca",
        "#7c3aed",
        "#9333ea",
        "#c2410c",
        "#b91c1c"
      ],
      "colorsDark": [
        "#a1a1aa",
        "#4ade80",
        "#86efac",
        "#22d3ee",
        "#38bdf8",
        "#60a5fa",
        "#818cf8",
        "#a78bfa",
        "#c084fc",
        "#fb923c",
        "#f87171"
      ],
      "unknownItem": { "light": "#7c3aed", "dark": "#c084fc" }
    },
    "panelMaxWidthsPx": {
      "narrow": 480,
      "dataControls": 680,
      "wide": 1280,
      "unitGrid": 1920
    },
    "completionChips": {
      "source": "src/utils/completion-chip-color.ts",
      "gray": {
        "light": { "backgroundColor": "#9ca3af", "color": "#111827" },
        "dark": { "backgroundColor": "#52525b", "color": "#fafafa" }
      },
      "progressStops": [
        { "minRatio": 0.001, "backgroundColor": "#dc2626", "color": "#ffffff" },
        { "minRatio": 0.125, "backgroundColor": "#c2410c", "color": "#ffffff" },
        { "minRatio": 0.25, "backgroundColor": "#f59e0b", "color": "#422006" },
        { "minRatio": 0.375, "backgroundColor": "#eab308", "color": "#422006" },
        { "minRatio": 0.5, "backgroundColor": "#a16207", "color": "#ffffff" },
        { "minRatio": 0.625, "backgroundColor": "#0369a1", "color": "#ffffff" },
        { "minRatio": 0.75, "backgroundColor": "#2563eb", "color": "#ffffff" },
        { "minRatio": 0.875, "backgroundColor": "#0e7490", "color": "#ffffff" },
        { "minRatio": 1, "backgroundColor": "#15803d", "color": "#ffffff" }
      ]
    }
  }
}
